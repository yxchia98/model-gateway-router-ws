# Provider keys are optional; add models and credentials in the Admin UI.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=

# Official stable multi-platform image, pinned at setup; review before upgrading.
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm@sha256:26aecfb02fb17ac6590f0549478561f9fbb3f69314317320b2e32a21beed4006
BIND_ADDRESS=127.0.0.1
LITELLM_PORT=4000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Keep POSTGRES_PASSWORD URL-safe (generated hex is safe).
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
REDIS_PASSWORD=REPLACE_WITH_RANDOM_HEX
LITELLM_MASTER_KEY=sk-REPLACE_WITH_RANDOM_HEX
# Do not regenerate the salt after storing credentials in PostgreSQL.
LITELLM_SALT_KEY=sk-REPLACE_WITH_RANDOM_HEX
UI_USERNAME=admin
UI_PASSWORD=REPLACE_WITH_RANDOM_HEX
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_HEX

