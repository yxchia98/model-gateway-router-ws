# Frontend VM only. Copy to .env.frontend (which is Git-ignored).
# Gateway base URL reachable FROM the frontend container. Do not append /v1.
# Replace this example address with the actual gateway VM address.
SWITCHYARD_URL=http://172.16.247.63:4002
FRONTEND_PORT=3002
# Use the same route configuration deployed on the gateway VM.
ROUTES_FILE=./routes.toml
